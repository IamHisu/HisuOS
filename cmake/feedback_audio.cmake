# Only this previously unused storage tail is flashed; existing data stays intact.
set(hisu_feedback_image "${PROJECT_DIR}/.cache/feedback-audio/feedback_audio.bin")
if(EXISTS "${hisu_feedback_image}")
    file(SIZE "${hisu_feedback_image}" hisu_feedback_size)
    if(NOT hisu_feedback_size EQUAL 983040)
        message(FATAL_ERROR "Invalid feedback image; run tools/prepare-feedback-audio.py again.")
    endif()
    partition_table_get_partition_info(hisu_storage_offset "--partition-name storage" "offset")
    partition_table_get_partition_info(hisu_storage_size "--partition-name storage" "size")
    math(EXPR hisu_feedback_end "0x3ea000 + ${hisu_feedback_size}")
    if(NOT hisu_storage_offset OR hisu_storage_size LESS hisu_feedback_end)
        message(FATAL_ERROR "Spoken feedback does not fit storage.")
    endif()
    math(EXPR hisu_feedback_address "${hisu_storage_offset} + 0x3ea000" OUTPUT_FORMAT HEXADECIMAL)
    esptool_py_flash_target_image(flash feedback_audio "${hisu_feedback_address}" "${hisu_feedback_image}")
else()
    message(WARNING "Spoken wake feedback missing; run tools/prepare-feedback-audio.py before flashing.")
endif()
