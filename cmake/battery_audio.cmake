# Optional PC-generated audio lives outside the app partitions.
set(hisu_battery_image "${PROJECT_DIR}/.cache/battery-audio/battery_audio.bin")
if(EXISTS "${hisu_battery_image}")
    file(SIZE "${hisu_battery_image}" hisu_battery_size)
    if(NOT hisu_battery_size EQUAL 1966080)
        message(FATAL_ERROR "Invalid battery audio image; run tools/prepare-battery-audio.py again.")
    endif()
    partition_table_get_partition_info(hisu_storage_offset "--partition-name storage" "offset")
    partition_table_get_partition_info(hisu_storage_size "--partition-name storage" "size")
    math(EXPR hisu_alert_end "0x206000 + ${hisu_battery_size}")
    if(NOT hisu_storage_offset OR hisu_storage_size LESS hisu_alert_end)
        message(FATAL_ERROR "Battery audio does not fit storage.")
    endif()
    math(EXPR hisu_alert_address "${hisu_storage_offset} + 0x206000" OUTPUT_FORMAT HEXADECIMAL)
    esptool_py_flash_target_image(flash battery_audio "${hisu_alert_address}" "${hisu_battery_image}")
else()
    message(WARNING "Offline Leda audio missing; run tools/prepare-battery-audio.py before flashing. Old voice recordings are not accepted.")
endif()
