CONFIG_IDF_TARGET="esp32s3"
CONFIG_SR_MN_EN_MULTINET7_QUANT=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# Keep small service allocations out of scarce Wi-Fi/DMA memory.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# PCM/base64 uplink needs about 43 kB/s; four MSS of send space stalls on high RTT.
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16
# TLS handshake allocations must leave internal RAM available for Wi-Fi/DMA.
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# AES DMA needs temporary internal buffers even when TLS lives in PSRAM.
# Use software AES so speaker DMA and TLS reception do not compete for them.
CONFIG_MBEDTLS_HARDWARE_AES=n
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# GPIO20 drives the LCD backlight and cannot also serve as USB D+.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=n
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n
CONFIG_LV_COLOR_DEPTH_16=y
# GIF framebuffer exceeds the old 96 KiB pool; use ESP-IDF's PSRAM-aware heap.
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_GIF=y
CONFIG_LV_USE_QRCODE=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# The Vietnamese font uses compressed glyph bitmaps (bitmap_format = 1).
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_USE_LOG=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=128
CONFIG_ESP_WS_CLIENT_SEPARATE_TX_LOCK=y
